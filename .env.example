# Copia este archivo como .env y completa los valores.

# Cadena de conexión de MongoDB (por ejemplo, de MongoDB Atlas)
MONGODB_URI=mongodb+srv://usuario:contraseña@tu-cluster.mongodb.net/smartsip

# Clave secreta para firmar los tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esta-clave

# API key de Google Gemini (opcional, solo para "Personalizar con IA")
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Puerto del servidor (opcional)
PORT=3000
